<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Candidate Onboarding" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-100 min-h-screen">
  <main class="max-w-4xl mx-auto px-6 py-10">
    <% flash.each do |type, message| %>
      <% css =
           case type.to_sym
           when :notice
             "mb-6 rounded-lg border border-green-200 bg-green-50 px-4 py-3 text-green-800"
           when :alert
             "mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-red-800"
           else
             "mb-6 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-gray-800"
           end %>

      <div class="<%= css %>">
        <%= message %>
      </div>
    <% end %>
    <%= yield %>
  </main>
  </body>
</html>
