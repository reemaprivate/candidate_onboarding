<%= form_with(
      url: onboarding_path,
      method: :post,
      multipart: true,
      class: "mt-8 space-y-6"
    ) do |f| %>

  <div class="rounded-lg border-2 border-dashed border-gray-300 bg-gray-50 p-8">

    <%= f.label :cv,
                "Choose your CV",
                class: label_classes %>

    <%= f.file_field :cv,
                     accept: ".pdf,.doc,.docx",
                     class: input_classes %>

    <p class="mt-3 text-sm text-gray-500">
      Supported formats:
      <strong>PDF, DOC, DOCX</strong>
      <br>
      Maximum size: 25 MB
    </p>

  </div>

  <div class="flex justify-end">
    <%= f.submit "Analyze CV",
                 class: primary_button_classes %>
  </div>

<% end %>