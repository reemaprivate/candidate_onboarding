<% if @candidate_profile.errors.any? %>
  <div class="mb-6 rounded-lg border border-red-200 bg-red-50 p-4">
    <h3 class="font-semibold text-red-700">
      <%= pluralize(@candidate_profile.errors.count, "error") %>
      prevented this form from being saved.
    </h3>

    <ul class="mt-2 list-disc pl-5 text-red-600">
      <% @candidate_profile.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with(
      url: onboarding_path,
      method: :post,
      multipart: true,
      class: "mt-8 space-y-6"
    ) do |f| %>

  <div class="rounded-lg border-2 border-dashed border-gray-300 bg-gray-50 p-8">

    <%= f.label :cv,
                t("onboardings.new.upload.choose_cv"),
                class: label_classes %>

    <%= f.file_field :cv,
                     accept: ".pdf,.doc,.docx",
                     class: input_classes %>

    <p class="mt-3 text-sm text-gray-500">
      <%= t("onboardings.new.upload.supported_formats") %>:
      <strong>PDF, DOC, DOCX</strong>
      <br>

      <%= t(
            "onboardings.new.upload.maximum_size",
            size: max_cv_file_size
          ) %>
    </p>

  </div>

  <div class="flex justify-end">
    <%= f.submit t("onboardings.new.upload.analyze_button"),
                 class: primary_button_classes %>
  </div>

<% end %>