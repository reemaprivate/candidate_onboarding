<div class="max-w-4xl mx-auto">
  <header class="mb-8">
    <h1 class="text-4xl font-bold tracking-tight text-gray-900">
      Candidate Onboarding
    </h1>
    <p class="mt-2 text-gray-600">
      Step 1 of 2 &middot; Upload your CV
    </p>
  </header>

  <section class="rounded-xl border border-gray-200 bg-white p-10 shadow-sm">
    <h2 class="text-3xl font-semibold text-gray-900">
      Upload your CV
    </h2>

    <p class="mt-4 leading-7 text-gray-600">
      Upload your CV and we will automatically fill in as much of your
      candidate profile as possible.
    </p>

    <p class="mt-3 leading-7 text-gray-600">
      You can review and edit everything before saving.
    </p>

    <%= render "cv_upload_form" %>

  </section>
</div>