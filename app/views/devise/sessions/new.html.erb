<%= render layout: "shared/auth_card" do %>

  <h1 class="text-3xl font-bold text-gray-900">
    Welcome back
  </h1>

  <p class="mt-2 text-gray-600">
    Sign in to continue your candidate onboarding.
  </p>

  <%= form_for(resource,
               as: resource_name,
               url: session_path(resource_name),
               html: { class: "mt-8 space-y-5" }) do |f| %>

    <div>
      <%= f.label :email, class: label_classes %>

      <%= f.email_field :email,
                        autofocus: true,
                        autocomplete: "email",
                        class: input_classes %>
    </div>

    <div>
      <%= f.label :password, class: label_classes %>

      <%= f.password_field :password,
                           autocomplete: "current-password",
                           class: input_classes %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me,
                    class: "text-sm text-gray-700" %>
      </div>
    <% end %>

    <%= f.submit "Log in", class: "mt-6 w-full rounded-lg bg-blue-600 px-4 py-3 font-medium text-white hover:bg-blue-700 transition" %>
  <% end %>

  <div class="mt-6 border-t pt-4 text-sm">
    <%= render "devise/shared/links" %>
  </div>

<% end %>